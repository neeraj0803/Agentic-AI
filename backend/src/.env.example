# Provider
LLM__PROVIDER="azure"

# Gemini
GEMINI__GOOGLE_API_KEY=xxxx
GEMINI__GEMINI_MODEL=gemini-2.5-flash

# Azure OpenAI
AZURE_OPENAI__AZURE_OPENAI_ENDPOINT=************
AZURE_OPENAI__AZURE_OPENAI_API_KEY=***********
AZURE_OPENAI__AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini-developers
AZURE_OPENAI__AZURE_OPENAI_API_VERSION=2025-01-01-preview

# Jira Cloud
JIRA__BASE_URL=https://api.atlassian.com/ex/jira/
JIRA__EMAIL=your-jira-account@example.com
JIRA__API_TOKEN=your-jira-api-token
JIRA__CLOUD_ID=your-jira-cloud-id